{
  "name": "vantage-ai",
  "version": "0.1.0",
  "description": "Compares two editions of an organisational regulation and registers functions that were lost, duplicated or moved, each traced to its source clause.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
